# git 은 코드·설정·문서와 작은 기록만 담는다 (2026-10-02 도입).
# 데이터·가중치는 크고 자주 바뀌어 git 이 아니라 백업으로 지킨다 — CLAUDE.md '다른 디스크 백업'.

# 다시 만들 수 있는 것
/graft/
/.venv/
__pycache__/
*.pyc

# 데이터·가중치·내보내기
/data/
/models/
/weights/
/export/
*.pt

# 이 PC 에서만 쓰는 Claude Code 설정, 그리고 Claude Code 워크트리(제 브랜치를 가진 별도 체크아웃 — 담으면 gitlink 로 들어간다)
/.claude/settings.local.json
/.claude/worktrees/

# Claude ↔ Gemini 로컬 작업 칠판 (2026-10-25). 턴마다 바뀌는 메모라 담지 않는다 — 남길 것은 CLAUDE.md·docs/experiments.md 로
/docs/collab.md

# 학습·평가 결과: 텍스트 기록(results.csv·args.yaml·history.jsonl·스크립트)만 담는다.
# 그래프·대조 시트(png/jpg)·라벨 사본(labels/*.txt)·로그·Runpod 묶음(tar)은 뺀다.
/runs/**
!/runs/**/
!/runs/**/*.csv
!/runs/**/*.json
!/runs/**/*.jsonl
!/runs/**/*.tsv
!/runs/**/*.yaml
!/runs/**/*.sh
!/runs/**/*.py
!/runs/**/*.md
# test_baseline 의 날짜 폴더는 잴 때마다 만드는 임시 데이터셋이다 — 기록은 history.jsonl 하나다
/runs/test_baseline/*/
# Runpod 폴더의 json 은 담지 않는다 — pod 조회 결과에는 공인 IP·포트·환경 변수가 들어갈 수 있다 (2026-10-31).
# 스크립트(.sh·.py)와 메모는 그대로 담기므로 거기에 키를 적지 말 것.
/runs/runpod/**/*.json
/runs/runpod/**/*.jsonl

# IDE 설정
.idea/
.vscode/

# 비밀 파일 (2026-10-31, GitHub 원격을 붙일 때). 자동 커밋 훅이 턴마다 git add -A 를 하므로 키가 든 파일이
# 생기면 사람이 보기 전에 커밋되고 다음 push 로 올라간다 — GitHub 은 개인 private 저장소에서 비밀을 걸러 주지
# 않는다. 키는 환경 변수에 둘 것. 이 블록은 맨 끝에 있어야 위의 runs/ 화이트리스트보다 나중에 적용된다.
.env
.env.*
*.env
.envrc
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.netrc
_netrc
.pypirc
.git-credentials
credentials
kaggle.json
rclone.conf
token.json
token.pickle
token.txt
secret.*
secrets.*
credentials.*
client_secret*.json
service_account*.json
*api_key
*_key.txt
# claude mcp add --scope project -e KEY=... 와 Gemini CLI 의 mcp add(기본 범위가 project)가 키를 그대로 적는다.
# Gemini 는 실행한 폴더에 .gemini/settings.json 을 만든다 — 하위 폴더 것까지 막는다 (11-01). 공유해야 하면 git add -f
.mcp.json
**/.gemini/settings.json
CLAUDE.local.md

# Git Bash 에서 cmd 식으로 2>nul 을 쓰면 생기는 파일 — git 이 읽지 못해 git add -A 가 통째로 실패한다 (11-01)
nul
# git mergetool 이 남기는 충돌 전 사본 — 충돌 표시가 그대로 들어 있다 (11-01)
*.orig

# 데이터 사본(이미지·DB·.npy 캐시)·영상·로그·압축 — runs/ 밖에 생겨도 담지 않는다 (위 '데이터·가중치' 와 같은
# 이유). 이미지는 11-01 에 넣었다 — 기본값이 아닌 폴더로 내보내면 수천 장이 커밋되려 했다. 문서에 그림을
# 넣을 때는 git add -f.
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.tif
*.tiff
*.avif
*.npy
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.db
*.db.bak*
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
nohup.out
*.tar
*.tar.gz
*.tgz
*.zip
