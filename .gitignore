# git 은 코드·설정·문서와 작은 기록만 담는다 (2026-10-02 도입).
# 데이터·가중치는 크고 자주 바뀌어 git 이 아니라 백업으로 지킨다 — CLAUDE.md '외부 백업'.

# 다시 만들 수 있는 것
/graft/
/.venv/
__pycache__/
*.pyc

# 데이터·가중치·내보내기
/data/
/models/
/weights/
/export/
*.pt

# 이 PC 에서만 쓰는 Claude Code 설정
/.claude/settings.local.json

# 학습·평가 결과: 텍스트 기록(results.csv·args.yaml·history.jsonl·스크립트)만 담는다.
# 그래프·대조 시트(png/jpg)·라벨 사본(labels/*.txt)·로그·Runpod 묶음(tar)은 뺀다.
/runs/**
!/runs/**/
!/runs/**/*.csv
!/runs/**/*.json
!/runs/**/*.jsonl
!/runs/**/*.tsv
!/runs/**/*.yaml
!/runs/**/*.sh
!/runs/**/*.py
!/runs/**/*.md
# test_baseline 의 날짜 폴더는 잴 때마다 만드는 임시 데이터셋이다 — 기록은 history.jsonl 하나다
/runs/test_baseline/*/

# IDE 설정
.idea/
.vscode/
